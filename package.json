{
  "private": true,
  "type": "module",
  "browserslist": [
    "last 3 versions",
    "IE 11",
    "Firefox ESR"
  ],
  "scripts": {
    "editorconfig": "editorconfig-cli",
    "stylelint": "stylelint \"source/sass/**/*.scss\" --syntax scss",
    "test": "npm run editorconfig & npm run stylelint & eslint source/js/",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && cross-env NODE_ENV=production gulp build & gulp imagemin",
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && cross-env NODE_ENV=development gulp start",
    "dev": "set NODE_OPTIONS=--openssl-legacy-provider && cross-env NODE_ENV=development gulp start",
    "imagemin": "gulp imagemin",
    "webp": "gulp webp"
  },
  "editorconfig-cli": [
    "*.json",
    "*.js",
    "source/**/*.html",
    "source/**/*.pug",
    "source/js/**/*.js",
    "source/img/**/*.svg",
    "source/sass/**/*.{sass,scss}"
  ],
  "devDependencies": {
    "@babel/preset-env": "7.18.6",
    "autoprefixer": "10.4.7",
    "babel-loader": "8.2.5",
    "browser-sync": "2.27.10",
    "circular-dependency-plugin": "5.2.2",
    "clean-webpack-plugin": "3.0.0",
    "cross-env": "7.0.3",
    "del": "6.1.1",
    "duplicate-package-checker-webpack-plugin": "3.0.0",
    "eslint": "7.32.0",
    "gulp": "4.0.2",
    "gulp-csso": "4.0.1",
    "gulp-dom": "^1.0.0",
    "gulp-file-include": "2.3.0",
    "gulp-group-css-media-queries": "1.2.2",
    "gulp-html-beautify": "1.0.1",
    "gulp-imagemin": "7.1.0",
    "gulp-plumber": "1.2.1",
    "gulp-postcss": "9.0.1",
    "gulp-rename": "1.4.0",
    "gulp-sass": "5.1.0",
    "gulp-svgstore": "7.0.1",
    "gulp-webp": "4.0.1",
    "postcss": "8.4.14",
    "sass": "1.53.0",
    "stylelint": "13.13.1",
    "webpack": "4.42.0",
    "webpack-stream": "5.2.1"
  },
  "engines": {
    "node": ">=16.15.1"
  },
  "dependencies": {
    "imask": "^7.6.1",
    "swiper": "^11.2.1"
  }
}
